{
  "name": "scenery",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types && prettier --write worker-configuration.d.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "deploy": "wrangler d1 migrations apply DB --remote && opennextjs-cloudflare build && wrangler deploy",
    "dev": "next dev --port 3737",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "migrate": "wrangler d1 migrations apply DB --local",
    "start": "next start",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare-d1",
    "cloudflare-workers",
    "cloudflare-workflows",
    "drizzle-orm",
    "movie-tracker",
    "nextjs",
    "opennext",
    "rss",
    "tmdb",
    "typescript"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "description": "A self-hosted movie-release tracker that scores new releases from TMDB and OMDB data and finds the best torrent for each, on Cloudflare Workers and D1.",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/scenery.git"
  },
  "homepage": "https://github.com/mridang/scenery",
  "bugs": "https://github.com/mridang/scenery/issues",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "drizzle-orm": "^0.45.4",
    "feed": "^6.0.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^2.1.0",
    "@tailwindcss/postcss": "^4",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@eslint/core": "1.2.1",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}

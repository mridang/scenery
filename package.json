{
  "name": "scenery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf-typegen": "wrangler types",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@mridang/eslint-defaults": "^1.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "knip": "^5.88.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.86.0"
  }
}

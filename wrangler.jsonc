{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scenery",
  "main": "src/worker.ts",
  "account_id": "779037e608ab1102679ef8b1bd499d49",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare auto-routes the Worker to the colo closest to D1
  // (avoids the worst-case ~70 ms hop). Free on all plans.
  "placement": { "mode": "smart" },
  // Full Workers Observability: logs, metrics, invocation traces — all
  // sampled at 100% (the volume is tiny, the data is gold for debugging
  // an opaque background pipeline).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  // Custom domain — the workers.dev subdomain is disabled so the
  // canonical URL is the one we control. The apps.mrida.ng zone must be
  // attached to this Cloudflare account for the custom_domain bind to
  // succeed.
  "workers_dev": false,
  "routes": [{ "pattern": "scenery.apps.mrida.ng", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scenery-db",
      "database_id": "f9cdf278-d8df-4222-a2d6-9d5b45809d4d",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["0 6 * * *"],
  },
  "workflows": [
    {
      "name": "scenery-scrape",
      "binding": "SCRAPE_WORKFLOW",
      "class_name": "ScrapeWorkflow",
    },
    {
      "name": "scenery-movie",
      "binding": "MOVIE_WORKFLOW",
      "class_name": "MovieWorkflow",
    },
  ],
  // SCRAPINGANT_API_KEY, TMDB_API_KEY, CRON_SECRET are Worker secrets
  // (set via `wrangler secret put`), not plaintext vars.
}

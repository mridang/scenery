{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scenery",
  "main": "src/worker.ts",
  "account_id": "779037e608ab1102679ef8b1bd499d49",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare auto-routes the Worker to the colo closest to D1
  // (avoids the worst-case ~70 ms hop). Free on all plans.
  "placement": { "mode": "smart" },
  // Wrangler's own usage telemetry for this project (anonymous CLI usage; the
  // setting overrides each developer's personal preference).
  "send_metrics": true,
  // Workers Observability, everything on at 100% (the volume is tiny and the data
  // is what debugging needs): the app's own log lines, the automatic per-request
  // invocation logs, distributed traces, and real-time Issues. Query strings are
  // stripped from the URLs in logs and traces, because they can carry search
  // text, addresses and sign-in codes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  // Custom domain — the workers.dev subdomain is disabled so the
  // canonical URL is the one we control. The apps.mrida.ng zone must be
  // attached to this Cloudflare account for the custom_domain bind to
  // succeed.
  "workers_dev": false,
  "routes": [{ "pattern": "scenery.apps.mrida.ng", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scenery-db",
      // Create with `wrangler d1 create <database_name>` and paste the id here.
      "database_id": "f9cdf278-d8df-4222-a2d6-9d5b45809d4d",
      "migrations_dir": "migrations",
    },
  ],
  // Scales remote pictures down (and re-encodes them as WebP) in the Worker, for
  // the /api/img proxy. Needs no zone setting. Free monthly allowance; see
  // src/lib/images/proxy.ts.
  "images": {
    "binding": "IMAGES",
  },
  // The release id, so cached pages are keyed to the release that made them.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Cloudflare Workers Rate Limiting: the first line of defence, checked in the
  // Worker before the app, D1, Google, a model or an outbound fetch is touched
  // (src/lib/http/edge-limits.ts and extras.ts say which request counts against
  // which binding; a test keeps this list and those tables in step). A page or
  // picture served from a cache still counts. Limits are per Cloudflare location
  // and eventually consistent: a cost guard, not an accounting system.
  // namespace_id is account-wide and shared by every Worker that uses the same
  // number, hence the distinctive 72xx range.
  "ratelimits": [
    // pictures through /api/img, per person: a grid loads dozens, cache hits are cheap
    {
      "name": "RL_COVER",
      "namespace_id": "7201",
      "simple": { "limit": 600, "period": 60 },
    },
    // the rest of the API, per person
    {
      "name": "RL_API",
      "namespace_id": "7202",
      "simple": { "limit": 120, "period": 60 },
    },
    // well-known documents, health and crawler files, per address
    {
      "name": "RL_DISCOVERY",
      "namespace_id": "7203",
      "simple": { "limit": 120, "period": 60 },
    },
    // browser reports (what the CSP blocked), per address: a broken page can send many
    {
      "name": "RL_REPORTS",
      "namespace_id": "7204",
      "simple": { "limit": 60, "period": 60 },
    },
    // pages, per address
    {
      "name": "RL_SITE",
      "namespace_id": "7205",
      "simple": { "limit": 300, "period": 60 },
    },
    // everything, per address: bounds callers who make up session cookies
    {
      "name": "RL_ADDRESS",
      "namespace_id": "7206",
      "simple": { "limit": 900, "period": 60 },
    },
  ],
  "triggers": {
    // 06:00 UTC — daily scrape + per-movie dispatch.
    // 17:00 UTC — daily push notification (top-5 new movies).
    "crons": ["0 6 * * *", "0 17 * * *"],
  },
  "workflows": [
    {
      "name": "scenery-scrape",
      "binding": "SCRAPE_WORKFLOW",
      "class_name": "ScrapeWorkflow",
    },
    {
      "name": "scenery-movie",
      "binding": "MOVIE_WORKFLOW",
      "class_name": "MovieWorkflow",
    },
    {
      "name": "scenery-notify",
      "binding": "NOTIFY_WORKFLOW",
      "class_name": "NotifyWorkflow",
    },
  ],
  "vars": {
    // VAPID public key — not a secret; the browser needs it to subscribe.
    "VAPID_PUBLIC_KEY": "BCr55yfhMisowNEJX1YOvwc6yTeVi5iv8D-zmMleYMby0nz0nDHsfo5h5EVN4UfZGl60dzr2pWfOWgf-dU5xgVQ",
    "VAPID_SUBJECT": "mailto:mridang.agarwalla@gmail.com",
  },
  // Worker secrets (set via `wrangler secret put`), not plaintext vars. A deploy
  // fails if one is missing, and only these names are typed and loaded from .env.
  // CRON_SECRET is left out on purpose: the operator endpoint is open without it,
  // which local development relies on.
  "secrets": {
    "required": [
      "SCRAPINGANT_API_KEY",
      "TMDB_API_KEY",
      "OMDB_API_KEY",
      "VAPID_PRIVATE_KEY",
    ],
  },
  // Uploads source maps with the Worker so stack traces in logs and traces
  // point at the original source.
  "upload_source_maps": true,
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Scenery API",
    "version": "1.0.0",
    "description": "The REST contract of scenery. Everything outside /api (health, img, csp/reports, magnet, feed.xml) is not part of it. Errors are application/problem+json (RFC 9457). Timestamps are RFC 3339.",
    "x-api-id": "7a3c1d2e-5b6f-4c08-9d41-2f6e8a0b9c11",
    "x-audience": "company-internal"
  },
  "security": [],
  "paths": {
    "/api/push/configuration": {
      "get": {
        "operationId": "getPushConfiguration",
        "summary": "The VAPID public key the browser passes to pushManager.subscribe.",
        "description": "Not a secret: it only identifies the app to the push service. Public.",
        "security": [],
        "responses": {
          "200": {
            "description": "The configuration.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=3600"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushConfiguration"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Limits are enforced by the platform (Cloudflare Workers Rate Limiting); wait Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/push/subscriptions": {
      "post": {
        "operationId": "createPushSubscription",
        "summary": "Register a Web Push subscription.",
        "description": "The body is the JSON of a browser PushSubscription. Registering an endpoint again replaces its keys. The app has no accounts, so this is public.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSubscriptionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushSubscription"
                }
              }
            }
          },
          "200": {
            "description": "Already registered; the keys were replaced.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushSubscription"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "413": {
            "description": "The body is too large.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "415": {
            "description": "The body is not JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "429": {
            "description": "Too many requests. Limits are enforced by the platform (Cloudflare Workers Rate Limiting); wait Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/push/subscriptions/{id}": {
      "delete": {
        "operationId": "deletePushSubscription",
        "summary": "Forget a Web Push subscription.",
        "description": "The id is the lowercase hex SHA-256 of the subscription endpoint. Public.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Forgotten.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "404": {
            "description": "No such push subscription.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "429": {
            "description": "Too many requests. Limits are enforced by the platform (Cloudflare Workers Rate Limiting); wait Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/operations": {
      "post": {
        "operationId": "createOperation",
        "summary": "Run an operator operation now and record it.",
        "description": "Runs inside the request. Answers 201 whether the run succeeded or failed; its status says which. Requires the operator token (the CRON_SECRET) as a bearer token; where no secret is set (local development) it is open.",
        "security": [
          {
            "operatorToken": ["operations.write"]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The operation, ended.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "413": {
            "description": "The body is too large.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "415": {
            "description": "The body is not JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "401": {
            "description": "Missing or wrong operator token.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Limits are enforced by the platform (Cloudflare Workers Rate Limiting); wait Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "summary": "One operation and, once it has ended, its result.",
        "security": [
          {
            "operatorToken": ["operations.read"]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong operator token.",
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such operation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            }
          },
          "429": {
            "description": "Too many requests. Limits are enforced by the platform (Cloudflare Workers Rate Limiting); wait Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/X-Flow-ID"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "operatorToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The CRON_SECRET. Scopes are documentation only: one token grants both."
      }
    },
    "headers": {
      "X-Flow-ID": {
        "description": "Correlation id. Send one, or the server makes one; it is echoed on every response.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:~-]{1,128}$"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "type": "integer"
        }
      },
      "Location": {
        "description": "The absolute address of the resource.",
        "schema": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PushConfiguration": {
        "type": "object",
        "required": ["vapid_public_key"],
        "properties": {
          "vapid_public_key": {
            "type": "string"
          }
        }
      },
      "PushSubscriptionInput": {
        "type": "object",
        "required": ["endpoint", "keys"],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "keys": {
            "type": "object",
            "required": ["p256dh", "auth"],
            "properties": {
              "p256dh": {
                "type": "string"
              },
              "auth": {
                "type": "string"
              }
            }
          }
        }
      },
      "PushSubscription": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "OperationInput": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["pipeline_run", "omdb_backfill", "push_trigger"]
          },
          "parameters": {
            "type": "object",
            "description": "pipeline_run: source (scnsrc|ddlvalley), backfill_pages (0..100), steps (subset of scrape, enrich, torrents), torrent_providers (apibay|torrentio). omdb_backfill: limit (1..200, default 25). push_trigger: none."
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": ["id", "type", "status", "parameters", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": ["pipeline_run", "omdb_backfill", "push_trigger"]
          },
          "status": {
            "type": "string",
            "enum": ["running", "succeeded", "failed"]
          },
          "parameters": {
            "type": "object"
          },
          "result": {
            "type": "object",
            "description": "What the run returned, or {error} for a failed one."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
